            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a7"
                TIME_SLOT_REF1="ts39" TIME_SLOT_REF2="ts50">
                <ANNOTATION_VALUE>вот семантика это такой неорганизованный скорее раздел / лингвистики / </ANNOTATION_VALUE>
