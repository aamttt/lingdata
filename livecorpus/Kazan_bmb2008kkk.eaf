            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a9"
                TIME_SLOT_REF1="ts54" TIME_SLOT_REF2="ts65">
                <ANNOTATION_VALUE>вот / фонетика это / наиболее строгий / раздел / лингвистики</ANNOTATION_VALUE>
